<%= render 'layouts/header' %>

<div class="h-auto flex justify-center">
  <div class="w-[900px] px-[32px] py-[16px]">
    <div class="rounded-[22px] bg-[#F6F6F6]">
      <div class="p-[32px] overflow-y-auto">
        <div class="text-center mb-4 pb-[16px] border-b border-[rgba(0,0,0,0.1)]">
          <h1 class="text-2xl font-bold text-bnb_blue leading-tight">
            Edit Transaction
          </h1>
        </div>

        <div>
          <%= link_to invoice_path(@transaction.invoice),
              class: "inline-flex items-center px-3 py-2 rounded-lg text-bnb_blue hover:!bg-[rgb(37,45,96)] hover:!text-white transition-colors duration-200" do %>
            <i class="material-symbols-outlined mr-[6px]">arrow_back</i>
            Back to Invoice
          <% end %>
        </div>

        <div data-controller="transaction">
          <%= form_with model: @transaction, local: true do |f| %>
            <div class="transaction-form px-[16px] pt-[16px] mb-[16px]">
              <div>
                <p class="mb-[8px]">Transaction Reference Number</p>
                <div class="form-group mb-[24px]">
                  <p class="form-input readonly-field"><%= @transaction['external_transaction_ref'] || '-' %></p>
                </div>
              </div>

              <div>
                <p class="mb-[8px]">Transaction Date</p>
                <div class="form-group mb-[24px]">
                  <p class="form-input readonly-field"><%= @transaction['transaction_date'] || '-' %></p>
                </div>
              </div>

              <div>
                <p class="mb-[8px]">Currency</p>
                <div class="form-group mb-[24px]">
                  <p class="form-input readonly-field"><%= @transaction['currency'] || '-' %></p>
                </div>
              </div>

              <div>
                <p class="mb-[8px]">Tax Amount</p>
                <div class="form-group mb-[24px]">
                  <p class="form-input readonly-field"><%= @transaction['tax_amount'] || '-' %></p>
                </div>
              </div>

              <div>
                <p class="mb-[8px]">Amount</p>
                <div class="form-group mb-[24px]">
                  <%= f.number_field :amount,
                    { step: 0.01,
                      class: "form-input",
                      data: { transaction_target: "amount", action: "input->transaction#validateAmount" } } %>
                  <span class="error-message" data-transaction-target="amountError" style="color: red;"></span>
                </div>
              </div>
            </div>
            <div class="flex space-x-[16px] justify-end pr-[16px]">
              <button
                data-transaction-target="submitButton"
                class="btn-blue-bnb flex items-center disabled:opacity-50 disabled:cursor-not-allowed"
                type="submit"
                disabled>
                <i class="material-symbols-outlined !text-[20px] text-white mr-[8px] ml-[2px]">receipt_long</i>
                Submit
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

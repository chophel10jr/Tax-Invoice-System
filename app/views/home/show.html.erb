<%= render 'layouts/header' %>

<div class="h-auto lg:flex justify-center">
  <div class="lg:w-[800px] lg:px-[32px] py-[16px] px-[16px] bg-white lg:bg-[unset]">
    <div class="text-center lg:mb-6 pb-[16px] border-b border-[rgba(0,0,0,0.1)]">
      <h1 class="text-2xl lg:text-3xl font-bold text-bnb_blue leading-tight">
        Tax Invoice Generation Portal
      </h1>
    </div>
    <div class="rounded-[22px] bg-white lg:bg-[#F6F6F6]">
      <div data-controller="invoice">
        <%= form_with url: invoices_path, method: :post, local: true do |f| %>
          <div class="p-[16px] lg:p-[32px] overflow-y-auto">
            <div id="invoice-container" data-invoice-target="container" data-stepper-target="invoiceContainer">
              <div class="flex justify-between items-center">
                  <button data-action="click->invoice#addTransaction"
                          data-invoice-target="addTransactionButton" 
                          type="button"
                          class="btn-blue-bnb-outline flex items-center disabled:opacity-50 disabled:cursor-not-allowed"
                          id="add-transaction">
                    <i class="material-symbols-outlined !text-[20px] text-bnb_blue mr-[8px]">add</i>
                    Add Transaction
                  </button>
              </div>

              <div class="transaction-form border border-[rgba(0,0,0,0.1)] rounded-[8px] px-[16px] pt-[16px] my-[16px]">
                <div class="flex items-center justify-between mb-[8px]">
                  <p class="mb-0">
                    Transaction Reference Number <span class="text-bnb_red">*</span>
                  </p>

                  <i
                    class="material-symbols-outlined text-[20px] cursor-pointer text-bnb_blue remove-transaction"
                    title="This will remove transaction"
                    data-action="click->invoice#removeTransaction">
                    close
                  </i>
                </div>

                <div>
                  <div class="form-group mb-[24px]">
                    <%= text_field_tag "transaction_reference_numbers[]", nil,
                      { 
                        id: nil,
                        class: "form-input",
                        data: { invoice_target: "transactionReferenceNumber", action: "input->invoice#validateTransactionReferenceNumber" }
                      } %>
                  </div>
                </div>
              </div>
            </div>
          
            <div class="flex space-x-[16px] justify-end">
              <button
                data-invoice-target="submitButton"
                class="btn-blue-bnb flex items-center disabled:opacity-50 disabled:cursor-not-allowed"
                type="submit"
                disabled>
                <i class="material-symbols-outlined !text-[20px] text-white mr-[8px] ml-[2px]">receipt_long</i>
                Submit
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

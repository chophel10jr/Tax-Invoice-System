<%= render 'layouts/header' %>

<div class="h-auto flex justify-center">
  <div class="w-[900px] px-[32px] py-[16px]">
    <div class="rounded-[22px] bg-[#F6F6F6]">
      <div class="p-[32px] overflow-y-auto">
        <div class="text-center mb-4 pb-[16px] border-b border-[rgba(0,0,0,0.1)]">
          <h1 class="text-2xl font-bold text-bnb_blue leading-tight">
            Edit Customer
          </h1>
        </div>

        <div>
          <%= link_to invoice_path(7),
              class: "inline-flex items-center px-3 py-2 rounded-lg text-bnb_blue hover:!bg-[rgb(37,45,96)] hover:!text-white transition-colors duration-200" do %>
            <i class="material-symbols-outlined mr-[6px] text-bnb_red">arrow_back</i>
            Back to Invoice
          <% end %>
        </div>

        <div data-controller="customer">
          <%= form_with model: @customer, local: true do |f| %>
            <div class="customer-form px-[16px] pt-[16px] mb-[16px]">
              <div class="grid grid-cols-2 gap-x-[24px]">
                <div>
                  <p class="mb-[8px]">Customer Base Number</p>
                  <div class="form-group mb-[24px]">
                    <p class="form-input readonly-field"><%= @customer['external_customer_id'] || '-' %></p>
                  </div>
                </div>

                <div>
                  <p class="mb-[8px]">Tax Number</p>
                  <div class="form-group mb-[24px]">
                    <p class="form-input readonly-field"><%= @customer['tax_number'] || '-' %></p>
                  </div>
                </div>

                <div>
                  <p class="mb-[8px]">Name</p>
                  <div class="form-group mb-[24px]">
                    <%= f.text_field :name,
                      { class: "form-input",
                        data: { customer_target: "name", action: "input->customer#validateName" } } %>
                    <span class="error-message" data-customer-target="nameError" style="color: red;"></span>
                  </div>
                </div>

                <div>
                  <p class="mb-[8px]">CID Number</p>
                  <div class="form-group mb-[24px]">
                    <%= f.text_field :cid,
                      { class: "form-input",
                        data: { customer_target: "cid", action: "input->customer#validateCID" } } %>
                    <span class="error-message" data-customer-target="cidError" style="color: red;"></span>
                  </div>
                </div>

                <div>
                  <p class="mb-[8px]">Email Address</p>
                  <div class="form-group mb-[24px]">
                    <%= f.text_field :email,
                      { class: "form-input",
                        data: { customer_target: "email", action: "input->customer#validateEmail" } } %>
                    <span class="error-message" data-customer-target="emailError" style="color: red;"></span>
                  </div>
                </div>

                <div>
                  <p class="mb-[8px]">Phone Number</p>
                  <div class="form-group mb-[24px]">
                    <%= f.text_field :phone,
                      { class: "form-input",
                        data: { customer_target: "phone", action: "input->customer#validatePhone" } } %>
                    <span class="error-message" data-customer-target="phoneError" style="color: red;"></span>
                  </div>
                </div>
              </div>

              <div>
                <p class="mb-[8px]">Address</p>
                <div class="form-group mb-[24px]">
                  <%= f.text_field :address,
                    { class: "form-input",
                      data: { customer_target: "address", action: "input->customer#validateAddress" } } %>
                  <span class="error-message" data-customer-target="addressError" style="color: red;"></span>
                </div>
              </div>
            </div>
            <div class="flex space-x-[16px] justify-end pr-[16px]">
              <button
                data-customer-target="submitButton"
                class="btn-blue-bnb flex items-center disabled:opacity-50 disabled:cursor-not-allowed"
                type="submit"
                disabled>
                <i class="material-symbols-outlined !text-[20px] text-white mr-[8px] ml-[2px]">receipt_long</i>
                Submit
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
